////////////////////////////////////////////////////
//
// PHASE 3: FINANCIAL FOUNDATION
//
// Double-entry ledger, seller earnings and the
// reconciled seller-balance read model.
//
// The ledger is the immutable source of truth.
// SellerBalance is a cached projection that must
// reconcile to the ledger at all times.
//
////////////////////////////////////////////////////

// ENUMS
////////////////////////////////////////////////////

/// Classification of a general-ledger account.
enum LedgerAccountType {
  /// Asset accounts (e.g. clearing/cash accounts). Debit-normal.
  ASSET
  /// Liability accounts (e.g. amounts owed to sellers). Credit-normal.
  LIABILITY
  /// Revenue/income accounts. Credit-normal.
  REVENUE
  /// Expense accounts (e.g. commission income offsets). Debit-normal.
  EXPENSE
  /// Equity accounts. Credit-normal.
  EQUITY
}

/// Direction of a single ledger entry.
enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Business reason a ledger transaction was created.
/// Drives which accounts are debited/credited.
enum LedgerTransactionType {
  /// Funds captured for an order, posted at order creation.
  ORDER_SETTLEMENT
  /// An order earning moved from pending to available (no net money movement).
  EARNING_RELEASE
  /// A seller payout recorded (no provider integration in Phase 3).
  SELLER_PAYOUT
  /// An earning reversed/clawed back (refund, cancellation, correction).
  EARNING_REVERSAL
  /// Manual adjusting entry recorded by an admin.
  MANUAL_ADJUSTMENT
}

/// Lifecycle of a seller's earning for one order item.
enum EarningStatus {
  /// Recognized at order creation; not yet withdrawable.
  PENDING
  /// Released (e.g. after order confirmation); withdrawable.
  AVAILABLE
  /// Recorded as paid out. No money movement is executed in Phase 3.
  PAID
  /// Reversed (refund/cancellation/correction). No longer owed.
  REVERSED
}

// MODELS
////////////////////////////////////////////////////

/// A general-ledger account. The chart of accounts is seeded deterministically
/// and referenced by `code`. Ledger rows themselves are never mutated or
/// deleted (enforced by database triggers in the Phase 3 migration).
model LedgerAccount {
  id String @id @default(cuid())

  /// Stable, unique chart-of-accounts code, e.g. "2110" or "SELLER_PAYABLE".
  code String @unique

  name String

  type LedgerAccountType

  /// Normal balance direction: ASSET/EXPENSE are DEBIT normal,
  /// LIABILITY/REVENUE/EQUITY are CREDIT normal.
  normalDirection LedgerDirection

  /// Optional owning seller brand. Marketplace accounts leave this null.
  brandId String?

  brand Brand? @relation(fields: [brandId], references: [id])

  entries LedgerEntry[]

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([type])
}

/// An immutable, balanced double-entry transaction.
/// Every transaction MUST have total debits equal to total credits;
/// unbalanced transactions are rejected before persistence.
model LedgerTransaction {
  id String @id @default(cuid())

  /// Idempotent, globally-unique financial reference (e.g. "TXN:ORDER:...:SETTLE").
  /// Protected by a database UNIQUE constraint so a duplicated operation can
  /// never create a duplicated money movement, even under concurrency.
  reference String @unique

  type LedgerTransactionType

  /// Human-readable audit description.
  description String

  /// Related marketplace objects for audit traceability.
  orderId String?
  sellerEarningId String?
  brandId String?

  order Order? @relation(fields: [orderId], references: [id])
  sellerEarning SellerEarning? @relation(fields: [sellerEarningId], references: [id])
  brand Brand? @relation(fields: [brandId], references: [id])

  /// Total of debits (equals total of credits). Stored for fast audit checks.
  amount Decimal @db.Decimal(14, 2)

  currency String @default("NGN")

  /// Set when this transaction reverses a previously posted one.
  reversalOfId String?

  reversalOf LedgerTransaction? @relation("LedgerTransactionReversal", fields: [reversalOfId], references: [id])
  reversals LedgerTransaction[] @relation("LedgerTransactionReversal")

  entries LedgerEntry[]

  /// Financial actor that originated the transaction (user id / system).
  createdBy String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([sellerEarningId])
  @@index([brandId])
  @@index([type])
  @@index([createdAt])
}

/// One side of a double-entry transaction. Immutable after creation.
model LedgerEntry {
  id String @id @default(cuid())

  transactionId String

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])

  accountId String

  account LedgerAccount @relation(fields: [accountId], references: [id])

  direction LedgerDirection

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([accountId])
}

/// A seller's earning for a single order item.
/// Earnings are recognized at order creation and move through
/// PENDING -> AVAILABLE -> PAID, or to REVERSED.
model SellerEarning {
  id String @id @default(cuid())

  /// Idempotent key: one earning per order item, enforced at the database.
  orderItemId String @unique

  orderId String

  /// Seller snapshot copied from the product's brand at order creation.
  sellerBrandId String
  sellerBrandName String
  sellerUserId String?

  /// Commission rate actually applied (percentage, e.g. 3.00 = 3%),
  /// snapshotted so historical records never depend on later settings.
  commissionRate Decimal @db.Decimal(5, 2)

  /// Gross line amount the customer paid for this item.
  grossAmount Decimal @db.Decimal(14, 2)

  commissionAmount Decimal @db.Decimal(14, 2)

  /// grossAmount - commissionAmount.
  earningAmount Decimal @db.Decimal(14, 2)

  currency String @default("NGN")

  status EarningStatus @default(PENDING)

  /// Set when the earning becomes AVAILABLE.
  releasedAt DateTime?

  /// Set when the earning is marked PAID.
  paidAt DateTime?

  /// Set when the earning is REVERSED.
  reversedAt DateTime?

  /// The idempotent reference of the ledger transaction that reversed it.
  reversalReference String?

  ledgerTransactions LedgerTransaction[]

  order Order @relation(fields: [orderId], references: [id])

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([sellerBrandId])
  @@index([orderId])
  @@index([status])
}

/// Cached, reconciled read model of a seller's position.
/// The ledger remains the source of truth; this row is recomputed
/// by reconciliation. Balances may legitimately be negative.
model SellerBalance {
  id String @id @default(cuid())

  /// One balance row per seller brand, enforced at the database.
  sellerBrandId String @unique

  sellerBrandName String

  sellerUserId String?

  brand Brand @relation(fields: [sellerBrandId], references: [id])

  /// Earnings recognized but not yet released.
  pendingAmount Decimal @default(0) @db.Decimal(14, 2)

  /// Released and withdrawable but not yet paid.
  availableAmount Decimal @default(0) @db.Decimal(14, 2)

  /// Lifetime amount recorded as paid out.
  paidAmount Decimal @default(0) @db.Decimal(14, 2)

  /// Lifetime amount reversed.
  reversedAmount Decimal @default(0) @db.Decimal(14, 2)

  /// availableAmount - pending reversals exposure; can be negative
  /// (e.g. a reversal larger than the available balance).
  netAmount Decimal @default(0) @db.Decimal(14, 2)

  /// Lifetime gross recognized.
  lifetimeEarnings Decimal @default(0) @db.Decimal(14, 2)

  currency String @default("NGN")

  /// Last time this projection was reconciled against the ledger.
  lastReconciledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([sellerUserId])
}
