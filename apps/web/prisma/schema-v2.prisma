  total Decimal @db.Decimal(12, 2)

  // ========================================
  // Phase 3: Seller attribution snapshot.
  //
  // Captured at order creation so that
  // historical financial records NEVER depend
  // on later Product/Brand mutations. Every
  // value here is denormalized on purpose.
  // Nullable/defaulted so existing rows stay
  // valid after the additive migration.
  // ========================================

  sellerBrandId String?

  sellerBrandName String?

  sellerUserId String?

  /// Commission rate actually applied (percentage, e.g. 3.00 = 3%).
  commissionRate Decimal @default(0) @db.Decimal(5, 2)

  commissionAmount Decimal @default(0) @db.Decimal(14, 2)

  /// total - commissionAmount.
  earningAmount Decimal @default(0) @db.Decimal(14, 2)

  order Order @relation(fields: [orderId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  earning SellerEarning?

  createdAt DateTime @default(now())

  @@index([sellerBrandId])
}

