////////////////////////////////////////////////////
//
// LuxuryMarket Database v2.0
//
// Enterprise AI Marketplace
//
////////////////////////////////////////////////////

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

////////////////////////////////////////////////////
// PAYMENT ATTEMPTS
////////////////////////////////////////////////////

model PaymentAttempt {
  id String @id @default(cuid())

  paymentId String

  attemptNumber Int

  amount Decimal @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  provider String?

  providerReference String?

  failureReason String?

  attemptedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([paymentId, attemptNumber])
  @@index([paymentId])
  @@index([status])
  @@index([providerReference])
}

////////////////////////////////////////////////////
// REFUNDS
////////////////////////////////////////////////////

model Refund {
  id String @id @default(cuid())

  paymentId String

  amount Decimal @db.Decimal(12, 2)

  reason String?

  providerReference String?

  status RefundStatus @default(PENDING)

  processedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([providerReference])
}

////////////////////////////////////////////////////
// RECEIPTS
////////////////////////////////////////////////////

model Receipt {
  id String @id @default(cuid())

  paymentId String @unique

  receiptNumber String @unique

  issuedAt DateTime @default(now())

  pdfUrl String?

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
// MARKETPLACE SETTINGS
////////////////////////////////////////////////////

model MarketplaceSettings {
  id String @id @default(cuid())

  // Current marketplace commission chosen by Admin.
  // This is configurable and is not fixed at 10%.
  commissionRate Decimal @default(0) @db.Decimal(5, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////

enum UserRole {
  CUSTOMER
  BRAND_OWNER
  BRAND_STAFF
  ADMIN
  SUPER_ADMIN
}

enum BrandStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum PartnerType {
  PERSONAL
  POPULAR
}

enum PartnerApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

