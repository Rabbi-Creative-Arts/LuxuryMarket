generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  CUSTOMER
  BRAND
  ADMIN
}

enum BrandStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum BrandApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  FAILED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String

  firstName String
  lastName  String

  role UserRole @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////////
  // Brand Relationship
  //////////////////////////////////////////////////////

  brandId String?

  brand Brand? @relation(fields: [brandId], references: [id])

  //////////////////////////////////////////////////////
  // Auth.js
  //////////////////////////////////////////////////////

  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]

  @@index([brandId])
}

//////////////////////////////////////////////////////
// AUTH.JS
//////////////////////////////////////////////////////

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String @unique

  userId String

  providerAccountId String

  credentialPublicKey String

  counter Int

  credentialDeviceType String

  credentialBackedUp Boolean

  transports String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

//////////////////////////////////////////////////////
// BRAND
//////////////////////////////////////////////////////

model Brand {
  id String @id @default(cuid())

  //////////////////////////////////////////////////////
  // Basic Information
  //////////////////////////////////////////////////////

  name String

  slug String @unique

  description String?

  website String

  logo String?

  banner String?

  //////////////////////////////////////////////////////
  // Partnership
  //////////////////////////////////////////////////////

  status BrandStatus @default(PENDING)

  verified Boolean @default(false)

  approvedAt DateTime?

  //////////////////////////////////////////////////////
  // Audit
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////////////
  // Relationships
  ////////////////////////////////////////////////////

users User[]

contacts BrandContact[]

applications BrandApplication[]

documents BrandDocument[]

integrations BrandIntegration[]

products Product[]

dashboard BrandDashboard?

aiInsights AIInsight[]

supportTickets BrandSupportTicket[]

digitalPassports DigitalLuxuryPassport[]

webhookEndpoints WebhookEndpoint[]

erpMappings ERPMapping[]

@@index([slug])

@@index([status])
}

//////////////////////////////////////////////////////
// BRAND APPLICATION
//////////////////////////////////////////////////////

model BrandApplication {

  id String @id @default(cuid())

  //////////////////////////////////////////////////////
  // Company
  //////////////////////////////////////////////////////

  companyName String

  brandName String

  website String

  //////////////////////////////////////////////////////
  // Product Information
  //////////////////////////////////////////////////////

  productName String

  productCategory String?

  qualityRating Int

  manufactureDate DateTime?

  expirationDate DateTime?

  //////////////////////////////////////////////////////
  // Pricing
  //////////////////////////////////////////////////////

  officialPrice Decimal @db.Decimal(12,2)

  requestedLuxuryMarketPrice Decimal @db.Decimal(12,2)

  proposedCommission Decimal @db.Decimal(5,2)

  //////////////////////////////////////////////////////
  // Appointment
  //////////////////////////////////////////////////////

  appointmentCode String?

  //////////////////////////////////////////////////////
  // Review
  //////////////////////////////////////////////////////

  status BrandApplicationStatus @default(PENDING)

  reviewerNotes String?

  //////////////////////////////////////////////////////
  // Dates
  //////////////////////////////////////////////////////

  submittedAt DateTime @default(now())

  reviewedAt DateTime?

  //////////////////////////////////////////////////////
  // Relations
  //////////////////////////////////////////////////////

  brandId String?

  brand Brand? @relation(fields:[brandId], references:[id])

  @@index([status])

  @@index([brandId])
}

//////////////////////////////////////////////////////
// BRAND DOCUMENT
//////////////////////////////////////////////////////

model BrandDocument {

  id String @id @default(cuid())

  title String

  documentType String

  fileUrl String

  verified Boolean @default(false)

  uploadedAt DateTime @default(now())

  brandId String

  brand Brand @relation(fields:[brandId], references:[id], onDelete: Cascade)

  @@index([brandId])
}

//////////////////////////////////////////////////////
// BRAND CONTACT
//////////////////////////////////////////////////////

model BrandContact {

  id String @id @default(cuid())

  fullName String

  position String?

  email String

  phone String?

  primary Boolean @default(false)

  brandId String

  brand Brand @relation(fields:[brandId], references:[id], onDelete: Cascade)

  @@index([brandId])
}

//////////////////////////////////////////////////////
// BRAND INTEGRATION
//////////////////////////////////////////////////////

model BrandIntegration {

  id String @id @default(cuid())

  provider String

  apiEndpoint String?

  apiKey String?

  apiSecret String?

  status IntegrationStatus @default(NOT_CONNECTED)

  lastSync DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  brandId String

  brand Brand @relation(fields:[brandId], references:[id], onDelete: Cascade)

  @@index([brandId])

  @@index([status])
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String?

  icon String?

  banner String?

  featured Boolean @default(false)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([featured])
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id String @id @default(cuid())

  //////////////////////////////////////////
  // Identity
  //////////////////////////////////////////

  name String

  slug String @unique

  sku String @unique

  brandProductId String?

  barcode String?

  //////////////////////////////////////////
  // Description
  //////////////////////////////////////////

  shortDescription String?

  description String

  specifications String?

  materials String?

  careInstructions String?

  //////////////////////////////////////////
  // Brand
  //////////////////////////////////////////

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////
  // Category
  //////////////////////////////////////////

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  //////////////////////////////////////////
  // Official Website
  //////////////////////////////////////////

  officialProductUrl String

  //////////////////////////////////////////
  // Marketing
  //////////////////////////////////////////

  featured Boolean @default(false)

  trending Boolean @default(false)

  newArrival Boolean @default(false)

  bestSeller Boolean @default(false)

  luxuryMarketExclusive Boolean @default(false)

  //////////////////////////////////////////
  // Trust
  //////////////////////////////////////////

  officialBrandPartner Boolean @default(false)

  authenticityVerified Boolean @default(false)

  //////////////////////////////////////////
  // Publishing
  //////////////////////////////////////////

  status ProductStatus @default(DRAFT)

  publishedAt DateTime?

  //////////////////////////////////////////
  // Synchronization
  //////////////////////////////////////////

  lastSync DateTime?

  //////////////////////////////////////////
  // Audit
  //////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////
  // Relationships
  //////////////////////////////////////////

  images ProductImage[]

  prices ProductPrice[]

  offers PartnerOffer[]

  @@index([brandId])

  @@index([categoryId])

  @@index([slug])

  @@index([featured])

  @@index([status])
}

//////////////////////////////////////////////////////
// PRODUCT IMAGE
//////////////////////////////////////////////////////

model ProductImage {

  id String @id @default(cuid())

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl String

  alt String?

  position Int @default(0)

  isPrimary Boolean @default(false)

  thumbnail Boolean @default(false)

  image360 Boolean @default(false)

  videoUrl String?

  createdAt DateTime @default(now())

  @@index([productId])
}

//////////////////////////////////////////////////////
// PRODUCT PRICE
//////////////////////////////////////////////////////

model ProductPrice {

  id String @id @default(cuid())

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  country String

  currency String

  officialPrice Decimal @db.Decimal(12,2)

  luxuryMarketPrice Decimal @db.Decimal(12,2)

  customerSavings Decimal @db.Decimal(12,2)

  savingsPercentage Decimal @db.Decimal(5,2)

  taxIncluded Boolean @default(false)

  shippingIncluded Boolean @default(false)

  current Boolean @default(true)

  effectiveFrom DateTime

  effectiveTo DateTime?

  createdAt DateTime @default(now())

  @@index([productId])

  @@index([country])

  @@index([currency])

  @@index([current])
}

//////////////////////////////////////////////////////
// PARTNER OFFER
//////////////////////////////////////////////////////

model PartnerOffer {
  id String @id @default(cuid())

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title String

  description String?

  offerStatus OfferStatus @default(DRAFT)

  officialPrice Decimal @db.Decimal(12,2)

  luxuryMarketPrice Decimal @db.Decimal(12,2)

  customerSavings Decimal @db.Decimal(12,2)

  savingsPercentage Decimal @db.Decimal(5,2)

  freeShipping Boolean @default(false)

  giftWrapping Boolean @default(false)

  extendedWarranty Boolean @default(false)

  loyaltyPoints Int?

  freeGift String?

  startsAt DateTime

  endsAt DateTime?

  buyUrl String

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([productId])

  @@index([offerStatus])

  @@index([active])
}

//////////////////////////////////////////////////////
// COMMISSION AGREEMENT
//////////////////////////////////////////////////////

model CommissionAgreement {

  id String @id @default(cuid())

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  country String?

  category String?

  commissionPercentage Decimal @db.Decimal(5,2)

  customerDiscountPercentage Decimal @db.Decimal(5,2)

  luxuryMarketRevenuePercentage Decimal @db.Decimal(5,2)

  agreementStarts DateTime

  agreementEnds DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([brandId])

  @@index([active])
}

//////////////////////////////////////////////////////
// PRICE HISTORY
//////////////////////////////////////////////////////

model PriceHistory {

  id String @id @default(cuid())

  productPriceId String

  productPrice ProductPrice @relation(fields: [productPriceId], references: [id], onDelete: Cascade)

  officialPrice Decimal @db.Decimal(12,2)

  luxuryMarketPrice Decimal @db.Decimal(12,2)

  customerSavings Decimal @db.Decimal(12,2)

  recordedAt DateTime @default(now())

  @@index([productPriceId])
}

//////////////////////////////////////////////////////
// PROMOTION
//////////////////////////////////////////////////////

model Promotion {

  id String @id @default(cuid())

  title String

  description String?

  bannerImage String?

  startsAt DateTime

  endsAt DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TRACKING PROVIDER
//////////////////////////////////////////////////////

model TrackingProvider {
  id String @id @default(cuid())

  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name String

  apiEndpoint String?

  website String?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  trackingEvents TrackingEvent[]

  @@index([brandId])
}

//////////////////////////////////////////////////////
// TRACKING EVENT
//////////////////////////////////////////////////////

model TrackingEvent {
  id String @id @default(cuid())

  trackingProviderId String

  trackingProvider TrackingProvider     @relation(fields: [trackingProviderId], references: [id], onDelete: Cascade)

  trackingNumber String

  status String

  location String?

  message String?

  eventTime DateTime

  createdAt DateTime @default(now())

  @@index([trackingProviderId])

  @@index([trackingNumber])
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {

  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  message String

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([read])
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {

  id String @id @default(cuid())

  userId String?

  user User? @relation(fields: [userId], references: [id])

  action String

  entity String

  entityId String?

  details String?

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([entity])

  @@index([createdAt])
}

//////////////////////////////////////////////////////
// SYNC JOB
//////////////////////////////////////////////////////

model SyncJob {

  id String @id @default(cuid())

  brandIntegrationId String

  brandIntegration BrandIntegration     @relation(fields: [brandIntegrationId], references: [id], onDelete: Cascade)

  jobType String

  status IntegrationStatus @default(CONNECTING)

  startedAt DateTime @default(now())

  completedAt DateTime?

  productsProcessed Int @default(0)

  productsCreated Int @default(0)

  productsUpdated Int @default(0)

  productsFailed Int @default(0)

  durationMs Int?

  errorMessage String?

  createdAt DateTime @default(now())

  logs SyncLog[]

  @@index([brandIntegrationId])

  @@index([status])
}

//////////////////////////////////////////////////////
// SYNC LOG
//////////////////////////////////////////////////////

model SyncLog {

  id String @id @default(cuid())

  syncJobId String

  syncJob SyncJob     @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  level String

  message String

  createdAt DateTime @default(now())

  @@index([syncJobId])
}

//////////////////////////////////////////////////////
// PRODUCT SYNC STATE
//////////////////////////////////////////////////////

model ProductSyncState {

  id String @id @default(cuid())

  productId String

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  externalId String?

  checksum String?

  lastSyncedAt DateTime?

  syncStatus IntegrationStatus @default(NOT_CONNECTED)

  syncAttempts Int @default(0)

  lastError String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([productId])

  @@index([syncStatus])
}

//////////////////////////////////////////////////////
// AI SUGGESTION
//////////////////////////////////////////////////////

model AISuggestion {

  id String @id @default(cuid())

  productId String?

  product Product?     @relation(fields: [productId], references: [id])

  brandId String?

  brand Brand?     @relation(fields: [brandId], references: [id])

  type String

  priority Int @default(1)

  title String

  description String

  resolved Boolean @default(false)

  createdAt DateTime @default(now())

  resolvedAt DateTime?

  @@index([resolved])

  @@index([priority])
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {

  id String @id @default(cuid())

  name String @unique

  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {

  id String @id @default(cuid())

  name String @unique

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {

  id String @id @default(cuid())

  roleId String

  permissionId String

  role Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])

  @@index([roleId])

  @@index([permissionId])
}

//////////////////////////////////////////////////////
// PLATFORM SETTING
//////////////////////////////////////////////////////

model PlatformSetting {

  id String @id @default(cuid())

  key String @unique

  value String

  description String?

  updatedBy String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([key])
}

//////////////////////////////////////////////////////
// FEATURE FLAG
//////////////////////////////////////////////////////

model FeatureFlag {

  id String @id @default(cuid())

  name String @unique

  description String?

  enabled Boolean @default(false)

  rolloutPercentage Int @default(100)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([enabled])
}

//////////////////////////////////////////////////////
// FEATURE FLAG
//////////////////////////////////////////////////////



//////////////////////////////////////////////////////
// EXCHANGE RATE
//////////////////////////////////////////////////////

model ExchangeRate {

  id String @id @default(uuid())

  fromCurrencyId String

  toCurrencyId String

  fromCurrency Currency     @relation("FromCurrency", fields: [fromCurrencyId], references: [id])

  toCurrency Currency     @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  rate Decimal @db.Decimal(18,8)

  source String?

  updatedAt DateTime @updatedAt

  createdAt DateTime @default(now())

  @@unique([fromCurrencyId, toCurrencyId])

  @@index([fromCurrencyId])

  @@index([toCurrencyId])
}

//////////////////////////////////////////////////////
// COUNTRY
//////////////////////////////////////////////////////

model Country {

  id String @id @default(uuid())

  iso2 String @unique

  iso3 String @unique

  name String

  phoneCode String?

  flagEmoji String?

  defaultCurrencyId String

  defaultCurrency Currency     @relation(fields: [defaultCurrencyId], references: [id])

  active Boolean @default(true)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// LANGUAGE
//////////////////////////////////////////////////////

model Language {

  id String @id @default(uuid())

  code String @unique

  name String

  nativeName String

  active Boolean @default(true)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// USER PREFERENCE
//////////////////////////////////////////////////////

model UserPreference {

  id String @id @default(uuid())

  userId String @unique

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  countryId String?

  country Country?     @relation(fields: [countryId], references: [id])

  currencyId String?

  currency Currency?     @relation(fields: [currencyId], references: [id])

  languageId String?

  language Language?     @relation(fields: [languageId], references: [id])

  timezone String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// WISHLIST
//////////////////////////////////////////////////////

model Wishlist {

  id String @id @default(uuid())

  userId String

  productId String

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])

  @@index([userId])

  @@index([productId])
}

//////////////////////////////////////////////////////
// PRODUCT REVIEW
//////////////////////////////////////////////////////

model ProductReview {

  id String @id @default(uuid())

  userId String

  productId String

  rating Int

  title String?

  review String?

  verifiedPurchase Boolean @default(false)

  helpfulCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User     @relation(fields: [userId], references: [id])

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  votes ReviewVote[]

  @@unique([userId, productId])

  @@index([productId])

  @@index([rating])
}

//////////////////////////////////////////////////////
// REVIEW VOTE
//////////////////////////////////////////////////////

model ReviewVote {

  id String @id @default(uuid())

  reviewId String

  userId String

  helpful Boolean

  review ProductReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

//////////////////////////////////////////////////////
// AI RECOMMENDATION
//////////////////////////////////////////////////////

model AIRecommendation {

  id String @id @default(uuid())

  userId String

  productId String

  score Decimal @db.Decimal(5,2)

  reason String?

  displayed Boolean @default(false)

  clicked Boolean @default(false)

  purchased Boolean @default(false)

  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@index([score])
}

//////////////////////////////////////////////////////
// PRODUCT VIEW
//////////////////////////////////////////////////////

model ProductView {

  id String @id @default(uuid())

  userId String?

  productId String

  countryId String?

  device String?

  referrer String?

  viewedAt DateTime @default(now())

  user User?     @relation(fields: [userId], references: [id])

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  country Country?     @relation(fields: [countryId], references: [id])

  @@index([productId])

  @@index([viewedAt])
}

//////////////////////////////////////////////////////
// PRICE ALERT
//////////////////////////////////////////////////////

model PriceAlert {

  id String @id @default(uuid())

  userId String

  productId String

  targetPrice Decimal @db.Decimal(12,2)

  currencyId String

  active Boolean @default(true)

  createdAt DateTime @default(now())

  triggeredAt DateTime?

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  currency Currency     @relation(fields: [currencyId], references: [id])

  @@index([userId])

  @@index([productId])

  @@index([active])
}

//////////////////////////////////////////////////////
// BRAND DASHBOARD
//////////////////////////////////////////////////////

model BrandDashboard {

  id String @id @default(uuid())

  brandId String @unique

  brand Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  totalProducts Int @default(0)

  activeProducts Int @default(0)

  totalViews Int @default(0)

  totalWishlists Int @default(0)

  totalReviews Int @default(0)

  averageRating Decimal @db.Decimal(3,2)

  totalPriceAlerts Int @default(0)

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PRODUCT ANALYTICS
//////////////////////////////////////////////////////

model ProductAnalytics {

  id String @id @default(uuid())

  productId String @unique

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  views Int @default(0)

  uniqueVisitors Int @default(0)

  wishlistCount Int @default(0)

  reviewCount Int @default(0)

  averageRating Decimal @db.Decimal(3,2)

  recommendationClicks Int @default(0)

  priceAlertCount Int @default(0)

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// COUNTRY ANALYTICS
//////////////////////////////////////////////////////

model CountryAnalytics {

  id String @id @default(uuid())

  productId String

  countryId String

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  country Country     @relation(fields: [countryId], references: [id])

  views Int @default(0)

  wishlists Int @default(0)

  priceAlerts Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([productId, countryId])
}

//////////////////////////////////////////////////////
// TRENDING PRODUCT
//////////////////////////////////////////////////////

model TrendingProduct {

  id String @id @default(uuid())

  productId String @unique

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  score Decimal @db.Decimal(8,4)

  calculatedAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// AI INSIGHT
//////////////////////////////////////////////////////

model AIInsight {

  id String @id @default(uuid())

  brandId String

  brand Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  title String

  summary String

  recommendation String

  confidence Decimal @db.Decimal(5,2)

  priority Int @default(1)

  dismissed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([brandId])

  @@index([priority])
}

//////////////////////////////////////////////////////
// PURCHASE VERIFICATION
//////////////////////////////////////////////////////

model PurchaseVerification {

  id String @id @default(uuid())

  userId String

  productId String

  brandId String

  partnerOfferId String?

  verificationCode String @unique

  brandOrderReference String?

  purchaseDate DateTime

  purchasePrice Decimal @db.Decimal(12,2)

  purchaseCurrencyId String

  verified Boolean @default(false)

  verifiedAt DateTime?

  verificationMethod String

  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id])

  product Product     @relation(fields: [productId], references: [id])

  brand Brand     @relation(fields: [brandId], references: [id])

  partnerOffer PartnerOffer?     @relation(fields: [partnerOfferId], references: [id])

  purchaseCurrency Currency     @relation(fields: [purchaseCurrencyId], references: [id])

  @@index([userId])

  @@index([brandId])

  @@index([verified])
}

//////////////////////////////////////////////////////
// WARRANTY
//////////////////////////////////////////////////////

model Warranty {

  id String @id @default(uuid())

  purchaseVerificationId String @unique

